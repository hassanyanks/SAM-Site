extends index 

block append content
  if products.length
    div.grid-wrap
      each product in products
        div(style="width:20%").product-sample
          h1 #{product.name}
          img(style="margin:15px; width:80%; height:40%;", src="/images/" + product.image)
          button(style="margin:5px; color:white;", onclick="window.location.href='https://localhost:3000/products/" + product.id + "'") View details
  else 
    p There are no product samples
