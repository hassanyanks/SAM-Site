extends index 

block append content
      if products.length
        div.flex-wrap
          each product in products
            div(style="width:20%").product-sample
              h1 #{product.name}
              img(style="margin:15px; width:80%; height:40%;", src="/images/" + product.image)
              button#productdetail-button( style="margin:5px; color:white;") View details
                a(href=`/products/${product.id}`)
              //-form(method='POST')
              //-  input.text-input#datainfo-input(type='hidden', name='datainfo-input', value=product.id)
      else 
        h2(style="align-self:center") Nothing to see here yet--soon to come!!
      script(src="/eventListeners.mjs")