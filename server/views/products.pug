extends index 

block append content
      if products.length
        div.products-container
          each product in products
            div.product-container.product-narrow
              h2 #{product.name}
              img(src="/images/" + product.image)
              form.product-item(action=`/products/${product.id}`, method='GET', target="_blank")
                button.product-item(value=product.id) View details
      else 
        h2 Nothing to see here yet--soon to come!!
