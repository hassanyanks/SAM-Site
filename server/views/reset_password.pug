extends login_common

block content
  h1.reset-password Reset Password
  form.login-container(action='/reset-password' method='POST')
    //- Pass the user email to the hidden input field
    input.text-input(type='hidden', name='email', value=email)
    section.password-container
        input.text-input#password-fld(placeholder="Password" name="password" type="password" required autofocus)
        span#togglePassword Show
    button.text-input(type="submit") Update Password