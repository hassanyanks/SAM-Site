extends layout

block content
  form.login-container(action='/update-password' method='POST')
    //- Pass the user email to the hidden input field
    input.text-input(type='hidden', name='email', value=user.email)
    input.text-input(type='password', placeholder='New password', name='password', id='password', required)
    button.text-input(type='submit') Update Password
