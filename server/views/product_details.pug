extends common_layout

block append content

    div.products-container
        div.product-container.product-wide
            h2 #[strong #{product.name}]
            img(src="/images/" + product.image)
            h2 #[strong $#{product.price}]
            div.add-to-cart-container
                //-div.add-to-cart-quantity-container 
                form.cart-quantity-form(action=`/cart/add`, method='POST')
                    input(type="number", value="1", min="1", name="quantity").cart-current-quantity
                    button#add-to-cart-button(type="submit") Add to cart
                    input(type="hidden", name="id", value=product.id)
