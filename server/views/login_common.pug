extends common_layout 

block append content

    section.login-container
        form(action=url method="post")
            input.text-input(placeholder="Email" name="email" type="text" required autofocus)
            section.password-container
                input.text-input#password-fld(placeholder="Password" name="password" type="password" required)
                span#togglePassword Show
            button.text-input(type="submit") Submit
        script(src="/togglePswdListener.mjs")

