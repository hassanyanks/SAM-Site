doctype html
html
  head
    link(rel='stylesheet', type='text/css', href='/stylesheets/style.css')
    meta(http-equiv="Content-Security-Policy" content="default-src 'self'; form-action 'self';")
  body
    div.root-container
        div.top-grid
            div
            div#top-grid-middle 
                a(href='/index'): img(src="/images/home.png", alt="Home")
                span Sam's Products and Services
            div#top-grid-buttons-container
                form(action=`/cart` method="GET")
                    button(type="submit") Go to cart
                if user
                    form(action="/logout" method="POST")
                        button(type="submit") Log out
                else
                    form(action="/login" method="GET")
                        button(type="submit") Log in
        block content
    script(src="/loginListener.mjs")
