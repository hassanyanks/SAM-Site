extends login_common 

block prepend content

    h1.begin-section Log in

block append content

    section.alt-login-container
        hr
        span Forgot password? 
        form(action="/forgot-password-email-send" method="post")
            input.text-input(placeholder="Email" name="email" type="text" required autofocus)
            button.text-input(type="submit") Reset
        hr
        span Don't have an account?
        a(href="/signup") Sign up
