doctype html
html
  head
    link(rel='stylesheet', type='text/css', href='/stylesheets/style.css')
    meta(http-equiv="Content-Security-Policy" content="default-src 'self'; form-action 'self';")

    div.upload-div
        form(action="/upload" method="POST" enctype="multipart/form-data")
            input.upload-form-item(type="file" name="document" id="fileInput")
            button.upload-form-item(type="submit") Upload
        form(action="/index" method="GET")
            button.upload-form-item.upload-cancel(type="submit") Cancel
